# URL base de la API del backend (incluye el prefijo /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Autenticación OIDC contra Keycloak (Auth.js / NextAuth v5, arquitectura-tecnica.md §7).
# AUTH_KEYCLOAK_ISSUER debe incluir el realm: http://<host>/realms/<realm>.
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/helpcom
AUTH_KEYCLOAK_ID=facturacion-recurrente-frontend
AUTH_KEYCLOAK_SECRET=changeme

# Secreto para firmar/cifrar la sesión de Auth.js. Generar uno propio por entorno, p. ej.:
#   openssl rand -base64 32
AUTH_SECRET=changeme
