# Copia este archivo a ".env" en esta misma carpeta y completa los valores reales antes de
# levantar el stack (docker compose up). El ".env" real NUNCA se versiona (ver .gitignore) —
# todo lo de aquí son PLACEHOLDERS, sin secretos reales. Detalle de cada variable y cómo
# generar claves: docs/despliegue.md.

# ---------------------------------------------------------------------------------------
# PostgreSQL — base de la aplicación (usada también, en D2, por el backend)
# ---------------------------------------------------------------------------------------
POSTGRES_USER=facturacion
POSTGRES_PASSWORD=cambiar-esta-clave-postgres
POSTGRES_DB=facturacion_recurrente

# ---------------------------------------------------------------------------------------
# PostgreSQL — base SEPARADA para Keycloak, dentro del mismo contenedor Postgres
# (docs/despliegue.md: una base por aplicación, un solo motor Postgres que administrar).
# Estas tres variables las usa el script deploy/postgres-init/crear-base-keycloak.sh, que
# solo corre la PRIMERA vez que se crea el volumen de datos de Postgres.
# ---------------------------------------------------------------------------------------
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cambiar-esta-clave-keycloak-db

# ---------------------------------------------------------------------------------------
# Redis — caché del valor UF y lock del ciclo mensual (degradable: la app funciona sin él,
# ver arquitectura-tecnica.md §13). Con contraseña porque el servidor tendrá acceso remoto.
# ---------------------------------------------------------------------------------------
REDIS_PASSWORD=cambiar-esta-clave-redis

# ---------------------------------------------------------------------------------------
# Keycloak — identidad (OAuth2/OIDC), arquitectura-tecnica.md §7
# ---------------------------------------------------------------------------------------
# Usuario y clave del administrador inicial de Keycloak (realm "master"). Solo se usan la
# primera vez que arranca (al crear el volumen `keycloak_datos` vacío); cámbiala o gestiona
# usuarios adicionales desde la consola una vez levantado.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-esta-clave-admin-keycloak

# Hostname por el que se va a acceder a Keycloak. DELIBERADAMENTE VACÍO hasta D4 (a diferencia
# de otras variables "provisionales" de este archivo, esta NO tiene un valor provisional que
# rellenar): con KC_HOSTNAME vacío y KC_HOSTNAME_STRICT=false (docker-compose.yml), Keycloak
# se autoidentifica según la dirección con la que fue contactado en CADA request, en vez de
# forzar una sola — necesario para que el navegador (que lo alcanza en KEYCLOAK_PUBLIC_URL) y
# el propio contenedor del frontend (que también necesita alcanzarlo para el descubrimiento
# OIDC) obtengan el MISMO "issuer" que Auth.js exige que coincida (bug real de D3, ver
# KEYCLOAK_PUBLIC_URL abajo y docs/despliegue.md §D3). D4 SÍ le pone un valor fijo (el dominio
# público real detrás del reverse proxy con HTTPS, donde este problema deja de aplicar porque
# todo el tráfico pasa por el mismo proxy).
KEYCLOAK_HOSTNAME=

# URL COMPLETA y públicamente alcanzable de Keycloak (protocolo + host + puerto publicado,
# ver el servicio "keycloak" de docker-compose.yml — puerto 8081 por defecto). La usa el
# FRONTEND para construir tanto el link al que redirige al navegador a loguearse como el
# `issuer` para su propio descubrimiento OIDC del lado del servidor — DELIBERADAMENTE la misma
# dirección para ambos casos (docker-compose.yml, servicio "frontend", tiene el porqué
# completo: Keycloak agrega un parámetro "iss" a la respuesta de login que debe calzar
# exactamente con esta dirección, sea quien sea que la esté usando).
#
# El host es "keycloak.localhost", NO "localhost" a secas — cualquier navegador ya resuelve
# subdominios de ".localhost" como loopback sin configuración (RFC 6761), y el nombre distinto
# evita que choque con la entrada "localhost" que Alpine/musl ya trae de fábrica dentro del
# contenedor del frontend (ver `extra_hosts` del servicio "frontend"). Si accedes desde otra
# máquina de la oficina (no la del propio servidor), cambia el host por la IP LAN del servidor
# en esta variable Y en NEXT_PUBLIC_API_BASE_URL más abajo (ahí sí sirve una IP LAN normal, sin
# necesidad de ".localhost" — el problema del "iss" solo existe para el propio contenedor
# necesitando alcanzarse a sí mismo, no para máquinas realmente distintas en la LAN).
KEYCLOAK_PUBLIC_URL=http://keycloak.localhost:8081

# Realm de Keycloak que usan el backend y el frontend para validar/iniciar sesión. "helpcom" se
# crea SOLO (roles ADMINISTRADOR/OPERADOR, clientes OIDC, usuarios de prueba) al importar
# deploy/keycloak/realm-helpcom.json — automático la primera vez que arranca Keycloak sobre una
# base vacía (docs/despliegue.md §D3). No hace falta crearlo a mano.
KEYCLOAK_REALM=helpcom

# ---------------------------------------------------------------------------------------
# Backend (Spring Boot, perfil "prod") — docs/despliegue.md D2
# ---------------------------------------------------------------------------------------
# Nada más que configurar acá: el backend arma sus propias variables (DB_*, REDIS_*,
# KEYCLOAK_ISSUER_URI, ALMACENAMIENTO_*) a partir de las de arriba, directo en
# docker-compose.yml — no duplica valores en este archivo.

# ---------------------------------------------------------------------------------------
# Frontend (Next.js) — docs/despliegue.md D2. IMPORTANTE: distingue building-time vs.
# runtime (ver la nota larga en frontend/Dockerfile) antes de tocar estas variables.
# ---------------------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL se hornea EN EL BUILD de la imagen (`docker compose build
# frontend`) — un cambio acá NO tiene efecto hasta reconstruir la imagen. Tiene que ser una
# dirección que el NAVEGADOR del usuario pueda resolver (igual que KEYCLOAK_PUBLIC_URL), con
# el puerto publicado del backend (8080 por defecto, ver el servicio "backend"). Pública a
# propósito: no es secreta, cualquiera puede leerla en el bundle de JavaScript igual.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Dirección pública del PROPIO frontend (protocolo+host+puerto publicado, 3000 por defecto) —
# RUNTIME, no build arg. Auth.js la necesita para construir correctamente el redirect_uri que
# manda a Keycloak; sin ella, el server.js "standalone" de Next arma esa URL con el
# hostname/puerto de BIND del contenedor (0.0.0.0:3000) en vez de con la dirección real del
# navegador, y Keycloak la rechaza siempre por no calzar con ninguna Valid Redirect URI (bug
# real encontrado en D3, docs/despliegue.md §D3). Igual que KEYCLOAK_PUBLIC_URL: si accedes
# desde otra máquina de la oficina, cambia "localhost" por la IP LAN del servidor.
#
# TAMBIÉN la usa el BACKEND (docker-compose.yml, servicio "backend", CORS_ORIGENES_PERMITIDOS)
# para autorizar el origen desde el que el navegador llama a la API — es el mismo origin,
# por eso se reutiliza esta variable en vez de duplicarla (docs/deuda-tecnica.md: gap de CORS).
AUTH_URL=http://localhost:3000

# Estas sí son de RUNTIME (se leen al arrancar el contenedor, no al construir la imagen).
# Mismo client id que ya trae deploy/keycloak/realm-helpcom.json (§D3 de docs/despliegue.md).
AUTH_KEYCLOAK_ID=facturacion-recurrente-frontend

# OJO — este secreto vive en DOS lugares que deben coincidir, y solo uno de los dos se puede
# editar desde este archivo: el que ve el FRONTEND (esta variable) y el que Keycloak realmente
# exige (guardado en su base, sembrado por el import de deploy/keycloak/realm-helpcom.json). El
# placeholder de abajo coincide a propósito con el placeholder ya escrito en ese archivo JSON,
# así que el login funciona "de fábrica" nada más copiar este .env.example — pero es
# exactamente eso, un placeholder de ejemplo, versionado en el repo y por lo tanto público.
# Antes de cualquier uso real: genera un secreto nuevo (openssl rand -base64 32), ponlo AQUÍ, y
# regenera el client secret en Keycloak para que coincida (Admin Console → Clients →
# facturacion-recurrente-frontend → Credentials → Regenerate, y pega el mismo valor acá) — el
# procedimiento completo está en docs/despliegue.md §D3.
AUTH_KEYCLOAK_SECRET=cambiar-este-secreto-cliente-keycloak

# Secreto para firmar/cifrar la sesión de Auth.js. Generar uno propio, nunca reutilizar el de
# otro entorno: openssl rand -base64 32
AUTH_SECRET=cambiar-este-secreto-auth-js
